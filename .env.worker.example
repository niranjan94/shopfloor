# Copy to .env.worker (ignored by Git and Docker context).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_REVIEW_CLIENT_ID=
GITHUB_APP_REVIEW_PRIVATE_KEY=
ANTHROPIC_API_KEY=
SHOPFLOOR_AGENT_PROVIDER=claude
# OPENAI_API_KEY=
E2B_API_KEY=
SHOPFLOOR_E2B_TEMPLATE=
SHOPFLOOR_E2B_WORKER_PATH=/home/user/shopfloor-worker.cjs
SHOPFLOOR_EXECUTION_MODE=e2b
SHOPFLOOR_TRIGGER_LABEL=
SHOPFLOOR_MAX_REVIEW_ITERATIONS=3
SHOPFLOOR_REVIEW_MEMORY=false
SHOPFLOOR_EMBEDDING_MODEL=text-embedding-3-small
SHOPFLOOR_EMBEDDING_URL=https://api.openai.com/v1/embeddings
SHOPFLOOR_EMBEDDING_API_KEY=
