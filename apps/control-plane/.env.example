# Required — GitHub App webhook HMAC secret
GITHUB_WEBHOOK_SECRET=

# GitHub App (primary) — mutations
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=

# Optional review App — APPROVE / REQUEST_CHANGES on bot PRs
GITHUB_APP_REVIEW_CLIENT_ID=
GITHUB_APP_REVIEW_PRIVATE_KEY=

# Agent credentials (required on workers; optional on route-only control plane)
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# SHOPFLOOR_AGENT_PROVIDER=claude
# OPENAI_API_KEY=

# Pipeline knobs (mirror action.yml)
SHOPFLOOR_TRIGGER_LABEL=
SHOPFLOOR_MAX_REVIEW_ITERATIONS=3

# --- Job backend (pick one; priority: Inngest > HTTP worker > inline > logging) ---
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# SHOPFLOOR_WORKER_URL=https://your-deployment.vercel.app/api/worker/execute
# SHOPFLOOR_WORKER_TOKEN=
# SHOPFLOOR_INLINE_EXECUTE=false

# Durable run ledger (Neon)
# DATABASE_URL=

# E2B sandboxes for long implement (recommended in production)
# E2B_API_KEY=
# SHOPFLOOR_E2B_TEMPLATE=shopfloor-worker
# SHOPFLOOR_E2B_WORKER_PATH=/home/user/shopfloor-worker.cjs
# SHOPFLOOR_E2B_LOCAL_BRIDGE=false

# Optional Redis (Upstash) — reserved for future cache/leases
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Public URL override (otherwise derived from VERCEL_URL)
# SHOPFLOOR_PUBLIC_BASE_URL=https://shopfloor.example.com
